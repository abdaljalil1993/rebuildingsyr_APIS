### =========================================
### Citizen Assistance API Tests (REST Client)
### =========================================

@baseUrl = http://localhost:5000/api/v1
@contentType = application/json

@userToken = REPLACE_WITH_USER_JWT
@reviewerToken = REPLACE_WITH_REVIEWER_JWT
@adminToken = REPLACE_WITH_ADMIN_JWT

# Test Data - Update these with real IDs from responses
@serviceId = 1
@requestId = 1
@userId = 1
@serviceFieldId = 1
@newServiceId = 2

### Health
GET {{baseUrl}}/health

### Register (USER)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Ahmad User",
  "email": "ahmad.user@example.com",
  "password": "StrongPass123",
  "phone": "+970599000000",
  "city": "Gaza"
}

### Login (User/Reviewer/Admin)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "ahmad.user@example.com",
  "password": "StrongPass123"
}

### USER - Get Services
GET {{baseUrl}}/services
Authorization: Bearer {{userToken}}

### USER - Create Request
POST {{baseUrl}}/requests
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "serviceId": {{serviceId}},
  "data": [
    { "fieldId": 1, "value": "Gaza - Al Remal - Building 10" },
    { "fieldId": 2, "value": "Severe" },
    { "fieldId": 3, "value": "42000" }
  ],
  "media": [
    { "filePath": "uploads/proof-1.jpg", "type": "image" },
    { "filePath": "uploads/report-1.pdf", "type": "pdf" }
  ]
}

### USER - List My Requests
GET {{baseUrl}}/requests/my?page=1&limit=10&status=PENDING
Authorization: Bearer {{userToken}}

### USER - Get My Request By Id
GET {{baseUrl}}/requests/{{requestId}}
Authorization: Bearer {{userToken}}

### USER - Update Request (allowed only PENDING or NEEDS_INFO)
PATCH {{baseUrl}}/requests/{{requestId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "data": [
    { "fieldId": 1, "value": "Updated address" },
    { "fieldId": 2, "value": "Moderate" },
    { "fieldId": 3, "value": "35000" }
  ]
}

### USER - Delete Request
DELETE {{baseUrl}}/requests/{{requestId}}
Authorization: Bearer {{userToken}}

### REVIEWER - List Requests (mode=assigned|all)
GET {{baseUrl}}/reviewer/requests?page=1&limit=20&mode=all&status=PENDING
Authorization: Bearer {{reviewerToken}}

### REVIEWER - Update Request Status
PATCH {{baseUrl}}/reviewer/requests/{{requestId}}/status
Authorization: Bearer {{reviewerToken}}
Content-Type: {{contentType}}

{
  "status": "NEEDS_INFO"
}

### REVIEWER - Reject Request (reason required)
PATCH {{baseUrl}}/reviewer/requests/{{requestId}}/status
Authorization: Bearer {{reviewerToken}}
Content-Type: {{contentType}}

{
  "status": "REJECTED",
  "rejectionReason": "Uploaded ownership document is missing signature"
}

### REVIEWER - Add Note
POST {{baseUrl}}/reviewer/requests/{{requestId}}/note
Authorization: Bearer {{reviewerToken}}
Content-Type: {{contentType}}

{
  "note": "Please upload a clearer copy of your national ID."
}

### ADMIN - List Users
GET {{baseUrl}}/admin/users?page=1&limit=10&role=USER&search=ahmad
Authorization: Bearer {{adminToken}}

### ADMIN - Create User
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "name": "Reviewer One",
  "email": "reviewer.one@example.com",
  "password": "StrongPass123",
  "phone": "+970599000001",
  "city": "Gaza",
  "role": "REVIEWER"
}

### ADMIN - Update User
PATCH {{baseUrl}}/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "city": "Rafah",
  "role": "REVIEWER"
}

### ADMIN - Delete User
DELETE {{baseUrl}}/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}

### ADMIN - List Services
GET {{baseUrl}}/admin/services
Authorization: Bearer {{adminToken}}

### ADMIN - Create Service
POST {{baseUrl}}/admin/services
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "name": "Emergency Shelter",
  "description": "Urgent temporary shelter support"
}

### ADMIN - Update Service
PATCH {{baseUrl}}/admin/services/{{serviceId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "description": "Urgent temporary shelter and rent support"
}

### ADMIN - Delete Service
DELETE {{baseUrl}}/admin/services/{{serviceId}}
Authorization: Bearer {{adminToken}}

### ADMIN - List Service Fields
GET {{baseUrl}}/admin/service-fields?serviceId={{serviceId}}
Authorization: Bearer {{adminToken}}

### ADMIN - Create Service Field
POST {{baseUrl}}/admin/service-fields
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "serviceId": {{serviceId}},
  "fieldName": "beneficiary_count",
  "fieldType": "number",
  "required": true
}

### ADMIN - Update Service Field
PATCH {{baseUrl}}/admin/service-fields/{{serviceFieldId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "required": false
}

### ADMIN - Delete Service Field
DELETE {{baseUrl}}/admin/service-fields/{{serviceFieldId}}
Authorization: Bearer {{adminToken}}

### ADMIN - List Requests
GET {{baseUrl}}/admin/requests?page=1&limit=20&status=UNDER_REVIEW&city=Gaza
Authorization: Bearer {{adminToken}}

### ADMIN - Get Request Details (Admin)
GET {{baseUrl}}/admin/requests/{{requestId}}
Authorization: Bearer {{adminToken}}

### ADMIN - Override Request Status
PATCH {{baseUrl}}/admin/requests/{{requestId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "status": "APPROVED"
}

### ADMIN - Statistics
GET {{baseUrl}}/admin/statistics
Authorization: Bearer {{adminToken}}
