### =========================================
### Rebuildings Project API Tests (REST Client)
### Use with VS Code REST Client extension
### =========================================

@baseUrl = http://localhost:5000/api/v1
@contentType = application/json

# Set these manually after login responses
@userToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiYWNjb3VudFR5cGUiOiJVU0VSIiwiaWF0IjoxNzc0NzY2NTE4LCJleHAiOjE3NzQ4NTI5MTh9.Ngb7u8O9ETeiZ4Sw-7vyhTpJaCftknzEjUvJUukxOb4
@adminToken = REPLACE_WITH_ADMIN_JWT

# Replace these with real IDs from your DB / responses
@requestId = 1

### -----------------------------------------
### Health Check
### -----------------------------------------

GET {{baseUrl}}/health

### -----------------------------------------
### Auth - User
### -----------------------------------------

### Register User
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Mahmoud Al-Najjar",
  "phone": "+970599111222",
  "email": "mahmoud.user@example.com",
  "username": "mahmoud_user",
  "password": "StrongPass123",
  "nationalId": "402019876",
  "city": "Gaza",
  "socialStatus": "Married",
  "familyMembersNumber": 6
}

### Login User (email or username in identifier)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "identifier": "mahmoud.user@example.com",
  "password": "StrongPass123"
}

### Logout User
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{userToken}}

### -----------------------------------------
### Auth - Admin
### -----------------------------------------

# Note:
# Admin is not created through /auth/register in current implementation.
# Use an existing admin account seeded directly in DB.

### Login Admin
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "identifier": "admin@example.com",
  "password": "AdminStrongPass123"
}

### Logout Admin
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{adminToken}}

### -----------------------------------------
### User Profile (USER role)
### -----------------------------------------

### Get My Profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{userToken}}

### Update My Profile
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "Mahmoud Al-Najjar Updated",
  "phone": "+970599222333",
  "city": "Khan Younis",
  "socialStatus": "Married",
  "familyMembersNumber": 7
}

### -----------------------------------------
### Requests (USER role)
### -----------------------------------------

### Create Request - Reconstruction
POST {{baseUrl}}/requests
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "reqType": "RECONSTRUCTION",
  "reqDate": "2026-03-29T10:00:00.000Z",
  "description": "Main structure damaged, roof collapse, walls need complete rebuild.",
  "withDocs": false,
  "buildingNumber": "GAZA-B-1099"
}

### Create Request - Aid
POST {{baseUrl}}/requests
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "reqType": "AID",
  "reqDate": "2026-03-30T11:15:00.000Z",
  "description": "Temporary shelter support required for displaced family members.",
  "withDocs": false,
  "buildingNumber": "RAFAH-A-233"
}

### List My Requests (pagination + filters + search)
GET {{baseUrl}}/requests?page=1&limit=10&status=PENDING&type=RECONSTRUCTION&search=roof
Authorization: Bearer {{userToken}}

### Get My Request By ID
GET {{baseUrl}}/requests/{{requestId}}
Authorization: Bearer {{userToken}}

### Update My Request
PATCH {{baseUrl}}/requests/{{requestId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "description": "Updated details: second floor and stairwell are also damaged.",
  "withDocs": true,
  "buildingNumber": "GAZA-B-1099-REV1"
}

### Delete My Request
DELETE {{baseUrl}}/requests/{{requestId}}
Authorization: Bearer {{userToken}}

### Optional: Upload Request Document (multipart/form-data)
POST {{baseUrl}}/requests/{{requestId}}/documents
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="document"; filename="damage-report.pdf"
Content-Type: application/pdf

< ./sample-files/damage-report.pdf
--WebAppBoundary--

### -----------------------------------------
### Admin Endpoints (ADMIN role)
### -----------------------------------------

### Get Admin Statistics
GET {{baseUrl}}/admin/statistics
Authorization: Bearer {{adminToken}}

### List All Requests (pagination + filters + search + city)
GET {{baseUrl}}/admin/requests?page=1&limit=20&status=PENDING&type=AID&city=Gaza&search=family
Authorization: Bearer {{adminToken}}

### Update Request Status
PATCH {{baseUrl}}/admin/requests/{{requestId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "status": "UNDER_REVIEW"
}

### Review Request (Create Damage Report)
POST {{baseUrl}}/admin/requests/{{requestId}}/review
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "reportBy": "Eng. Omar Khaled",
  "reportDate": "2026-03-31T09:30:00.000Z",
  "description": "Inspection completed. Building foundation compromised and reconstruction required."
}
